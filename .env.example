# ==============================================================================
# TutorKhoj Environment Variables Template (Placeholders Only)
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to: .env.local
# 2. Fill in your real Supabase credentials in .env.local
# 3. .env.local is automatically ignored by Git and will NEVER be committed.
# ==============================================================================

# Supabase Public Project URL (Client-safe)
# Example format: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Client Public Key (Publishable / Anon Key - Client-safe)
# Example format: sb_publishable_... or eyJhbGciOi...
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional: If your dashboard references "anon public key" instead of "publishable key":
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local or Production Site URL (For Auth email confirmations and redirects)
VITE_SITE_URL=http://localhost:5173

# ==============================================================================
# SECURITY REMINDER:
# NEVER put SUPABASE_SERVICE_ROLE_KEY, payment secrets, or AI API keys in this file
# or in any client-facing code. Service-role keys bypass all Row Level Security.
# ==============================================================================
